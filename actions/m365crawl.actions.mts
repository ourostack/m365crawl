  ["content list", "read", "List immutable retained content observations, newest first."],
  ["content search", "read", "Search retained content text, titles and native metadata offline."],
  ["content show", "read", "Read one retained content observation offline."],
  ["content sources", "read", "Read registered content source coverage offline."],
  ["transcripts list", "read", "List meetings with recordings and their transcript parts, offline."],
