  ["skill", "read", "Print the agent guide (SKILL.md) for this version."],
  ["metadata", "read", "Print the crawlkit app manifest."],
  ["version", "read", "Print the m365crawl version, commit and build date."],
  ["help", "read", "Print every command as JSON, with who sees its effect, and the exit codes."],
];

const actions = ROWS.map(([cli, consent, summary]) =>
  defineAction({
    id: cli.replace(/[ -]/g, "_"),
    consent,
    label: cli.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase()),
    description: summary,
    agent: summary,
    input: {},
    output: {},
    cli,
  }),
);

export default defineActions("m365crawl", actions, { tool: "m365crawl" });
