  ["writes save-mail-draft", "write", "Save a new plain-text mail draft in the person's own mailbox."],
  ["writes reply-mail", "consequential", "Reply in plain text to one mail as the person directed."],
  ["writes reply-all-mail", "consequential", "Reply to everyone on one mail in plain text as the person directed."],
  ["writes send-mail", "consequential", "Send a new plain-text mail the person directed."],
  ["writes discard-mail-draft", "write", "Discard one draft in the person's own mailbox as the person directed."],
