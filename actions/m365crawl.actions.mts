  ["search", "read", "Full-text search over Teams chats, mail, transcripts, notes, documents and archived content."],
  ["messages", "read", "List Teams messages in chronological order from the archive."],
  ["conversations", "read", "List Teams conversations, newest activity first."],
  ["teams", "read", "List teams with channel counts, last activity and unread counts."],
  ["people list", "read", "List Teams and mail people with native Outlook observations."],
  ["people sync", "write", "Register and capture native Outlook people observations from supported profiles."],
  ["people show", "read", "Inspect one native person observation with its copies and contradictions."],
  ["people sources", "read", "Show registered native people sources and their coverage."],
  ["activity", "read", "List activity-feed items (mentions, replies, reactions) with their messages."],
  ["coverage", "read", "Show, per day and source, whether the archive holds what the apps cached."],
  ["calendar agenda", "read", "List calendar events for a date range, offline."],
  ["calendar event", "read", "Show one calendar event with everything the archive holds about it."],
  ["calendar sources", "read", "Show, per account and source, the days the calendar archive holds."],
  ["calendar actions", "read", "List action items of meeting recaps for events in a range."],
  ["calendar attendees sync", "write", "Capture native selected-detail attendee evidence from supported Outlook sources."],
  ["calendar attendees sources", "read", "Read registered native attendee sources and their archive coverage."],
  ["calendar attendees list", "read", "List an event's native attendee observations from the selected source."],
  ["calendar attendees show", "read", "Show one attendee observation with its snapshot and coverage."],
