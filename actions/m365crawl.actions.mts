// The commands m365crawl offers, declared once for ouro-actions. Each row is one CLI command: its words, who sees its
// effect (read, write on the person's own archive, or consequential, which reaches other people) and its one-line
// summary. `ouro-actions.mts generate` writes commands.json from these; the Go CLI's help table must match it.
import { defineAction, defineActions, type Consent } from "../tools/ouro-actions/ouro-actions.mts";

type Row = readonly [cli: string, consent: Exclude<Consent, "person-only">, summary: string];

const ROWS: readonly Row[] = [
  ["overview", "read", "Show what the archive holds per source, how fresh it is, and where to start."],
