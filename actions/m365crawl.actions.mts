  ["notes show", "read", "Show one note's text, elements and indexed hierarchy."],
  ["notes sources", "read", "Show registered note sources, capture history and coverage."],
  ["docs sync", "write", "Register and capture Office document metadata and OneDrive usage records; never opens files."],
  ["docs list", "read", "List document observations with stable IDs and source coverage."],
