{
  "schema_version": "crawlkit.control.v1",
  "id": "m365crawl",
  "display_name": "m365crawl",
  "description": "Mirror Microsoft 365 on this machine — Teams chats, Outlook mail and your calendar — into one local SQLite archive that agents can read offline.",
  "binary": {
    "name": "m365crawl"
  },
  "branding": {},
  "paths": {
    "config_env": "M365CRAWL_DB",
    "default_database": "~/.m365crawl/m365crawl.db"
  },
  "commands": {
    "calendar": {
      "argv": [
        "m365crawl",
        "--json",
        "calendar"
      ],
      "json": true
    },
    "doctor": {
      "argv": [
        "m365crawl",
        "--json",
        "doctor"
      ],
      "json": true
    },
    "mail folders": {
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "folders"
      ],
      "json": true
    },
    "mail list": {
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "list"
      ],
      "json": true
    },
    "mail show": {
      "title": "mail show (\u003cid\u003e is a placeholder: use an id printed by mail list)",
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "show",
        "\u003cid\u003e"
      ],
      "json": true
    },
    "mail thread": {
      "title": "mail thread (\u003cid\u003e is a placeholder: use an id printed by mail list)",
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "thread",
        "\u003cid\u003e"
      ],
      "json": true
    },
    "mail unread": {
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "unread"
      ],
      "json": true
    },
    "overview": {
      "title": "overview (m365crawl with no command): what the archive holds per source and where to start",
      "argv": [
        "m365crawl",
        "--json"
      ],
      "json": true
    },
    "search": {
      "argv": [
        "m365crawl",
        "--json",
        "search"
      ],
      "json": true
    },
    "status": {
      "argv": [
        "m365crawl",
        "--json",
        "status"
      ],
      "json": true
    },
    "sync": {
      "argv": [
        "m365crawl",
        "--json",
        "sync"
      ],
      "json": true,
      "mutates": true
    }
  },
  "capabilities": [
    "doctor",
    "status",
    "sync",
    "watch",
    "search",
    "sql",
    "chats",
    "mail",
    "calendar"
  ],
  "privacy": {
    "contains_private_messages": true,
    "exports_secrets": false,
    "local_only_scopes": [
      "teams_cache",
      "outlook_store"
    ]
  }
}
