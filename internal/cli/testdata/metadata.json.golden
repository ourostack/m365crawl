{
  "schema_version": "crawlkit.control.v1",
  "id": "m365crawl",
  "display_name": "m365crawl",
  "description": "Mirror Microsoft 365 on this machine — Teams chats, Outlook mail and your calendar — into one local SQLite archive that agents can read offline.",
  "binary": {
    "name": "m365crawl"
  },
  "branding": {},
  "paths": {
    "config_env": "M365CRAWL_DB",
    "default_database": "~/.m365crawl/m365crawl.db"
  },
  "commands": {
    "calendar": {
      "argv": [
        "m365crawl",
        "--json",
        "calendar"
      ],
      "json": true
    },
    "docs list": {
      "title": "docs list (local metadata only; show needs document-observation:ID; no document opened or fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "docs",
        "list"
      ],
      "json": true
    },
    "docs search": {
      "title": "docs search (local metadata only; show needs document-observation:ID; no document opened or fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "docs",
        "search",
        "\u003cwords\u003e"
      ],
      "json": true
    },
    "docs show": {
      "title": "docs show (local metadata only; show needs document-observation:ID; no document opened or fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "docs",
        "show",
        "\u003cdocument-observation-id\u003e"
      ],
      "json": true
    },
    "docs sources": {
      "title": "docs sources (local metadata only; show needs document-observation:ID; no document opened or fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "docs",
        "sources"
      ],
      "json": true
    },
    "docs sync": {
      "title": "docs sync (local metadata only; show needs document-observation:ID; no document opened or fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "docs",
        "sync"
      ],
      "json": true,
      "mutates": true
    },
    "doctor": {
      "argv": [
        "m365crawl",
        "--json",
        "doctor"
      ],
      "json": true
    },
    "loop list": {
      "title": "loop list (cached partial channel snapshots from the archive; show needs loop-channel:ID; nothing fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "loop",
        "list"
      ],
      "json": true
    },
    "loop search": {
      "title": "loop search (cached partial channel snapshots from the archive; show needs loop-channel:ID; nothing fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "loop",
        "search",
        "\u003cwords\u003e"
      ],
      "json": true
    },
    "loop show": {
      "title": "loop show (cached partial channel snapshots from the archive; show needs loop-channel:ID; nothing fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "loop",
        "show",
        "\u003cloop-channel-id\u003e"
      ],
      "json": true
    },
    "loop sources": {
      "title": "loop sources (cached partial channel snapshots from the archive; show needs loop-channel:ID; nothing fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "loop",
        "sources"
      ],
      "json": true
    },
    "loop sync": {
      "title": "loop sync (cached partial channel snapshots from the archive; show needs loop-channel:ID; nothing fetched)",
      "argv": [
        "m365crawl",
        "--json",
        "loop",
        "sync"
      ],
      "json": true,
      "mutates": true
    },
    "mail folders": {
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "folders"
      ],
      "json": true
    },
    "mail list": {
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "list"
      ],
      "json": true
    },
    "mail show": {
      "title": "mail show (\u003cid\u003e is a placeholder: use an id printed by mail list)",
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "show",
        "\u003cid\u003e"
      ],
      "json": true
    },
    "mail thread": {
      "title": "mail thread (\u003cid\u003e is a placeholder: use an id printed by mail list)",
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "thread",
        "\u003cid\u003e"
      ],
      "json": true
    },
    "mail unread": {
      "argv": [
        "m365crawl",
        "--json",
        "mail",
        "unread"
      ],
      "json": true
    },
    "notes list": {
      "title": "notes list (notes show needs an actual note:ID; notes search needs actual words)",
      "argv": [
        "m365crawl",
        "--json",
        "notes",
        "list"
      ],
      "json": true
    },
    "notes search": {
      "title": "notes search (notes show needs an actual note:ID; notes search needs actual words)",
      "argv": [
        "m365crawl",
        "--json",
        "notes",
        "search",
        "\u003cwords\u003e"
      ],
      "json": true
    },
    "notes show": {
      "title": "notes show (notes show needs an actual note:ID; notes search needs actual words)",
      "argv": [
        "m365crawl",
        "--json",
        "notes",
        "show",
        "\u003cnote-id\u003e"
      ],
      "json": true
    },
    "notes sources": {
      "title": "notes sources (notes show needs an actual note:ID; notes search needs actual words)",
      "argv": [
        "m365crawl",
        "--json",
        "notes",
        "sources"
      ],
      "json": true
    },
    "notes sync": {
      "title": "notes sync (notes show needs an actual note:ID; notes search needs actual words)",
      "argv": [
        "m365crawl",
        "--json",
        "notes",
        "sync"
      ],
      "json": true,
      "mutates": true
    },
    "overview": {
      "title": "overview (m365crawl with no command): what the archive holds per source and where to start",
      "argv": [
        "m365crawl",
        "--json"
      ],
      "json": true
    },
    "people": {
      "title": "people (native observations remain unresolved; show needs person-observation:ID)",
      "argv": [
        "m365crawl",
        "--json",
        "people"
      ],
      "json": true
    },
    "people show": {
      "title": "people show (native observations remain unresolved; show needs person-observation:ID)",
      "argv": [
        "m365crawl",
        "--json",
        "people",
        "show",
        "\u003cperson-observation-id\u003e"
      ],
      "json": true
    },
    "people sources": {
      "title": "people sources (native observations remain unresolved; show needs person-observation:ID)",
      "argv": [
        "m365crawl",
        "--json",
        "people",
        "sources"
      ],
      "json": true
    },
    "people sync": {
      "title": "people sync (native observations remain unresolved; show needs person-observation:ID)",
      "argv": [
        "m365crawl",
        "--json",
        "people",
        "sync"
      ],
      "json": true,
      "mutates": true
    },
    "search": {
      "argv": [
        "m365crawl",
        "--json",
        "search"
      ],
      "json": true
    },
    "status": {
      "argv": [
        "m365crawl",
        "--json",
        "status"
      ],
      "json": true
    },
    "sync": {
      "argv": [
        "m365crawl",
        "--json",
        "sync"
      ],
      "json": true,
      "mutates": true
    },
    "transcripts": {
      "title": "transcripts: recorded meetings and what of their transcripts is in the archive (offline)",
      "argv": [
        "m365crawl",
        "--json",
        "transcripts"
      ],
      "json": true
    },
    "transcripts show": {
      "title": "transcripts show (\u003cmeeting\u003e is a placeholder: use a call_id printed by transcripts)",
      "argv": [
        "m365crawl",
        "--json",
        "transcripts",
        "show",
        "\u003cmeeting\u003e"
      ],
      "json": true
    }
  },
  "capabilities": [
    "doctor",
    "status",
    "sync",
    "watch",
    "search",
    "sql",
    "chats",
    "mail",
    "calendar",
    "transcripts",
    "notes",
    "documents",
    "loop"
  ],
  "privacy": {
    "contains_private_messages": true,
    "exports_secrets": false,
    "local_only_scopes": [
      "teams_cache",
      "outlook_store",
      "onenote_index",
      "outlook_people",
      "office_json_metadata",
      "office_registry_metadata"
    ]
  }
}
